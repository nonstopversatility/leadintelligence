PORT=3000
NODE_ENV=development
SUPABASE_URL=
SUPABASE_PUBLIC_KEY=
SUPABASE_SECRET_KEY=
ANTHROPIC_API_KEY=
EMAIL_API_KEY=

# URL onde a aplicacao corre (usado nos links dos emails de recuperacao)
APP_URL=http://localhost:3000

# Email da empresa: envio de prospeccao e leitura das respostas. Sem isto, a mensagem abre no programa de email ou no webmail.
SMTP_USER=info@nonstop-versatility.pt
SMTP_PASS=
SMTP_NOME=Non Stop Versatility
SMTP_HOST=mail.nonstop-versatility.pt
# 26 no Render (as portas 25, 465 e 587 estao bloqueadas no plano gratuito); 465 noutros alojamentos
SMTP_PORT=26
IMAP_HOST=mail.nonstop-versatility.pt
IMAP_PORT=993
# EMAIL_LIMITE_DIARIO=20

# Google Calendar (OPCIONAL). Guia em docs/google-calendar.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
GOOGLE_LOGIN_HINT=nonstopversatility@gmail.com
